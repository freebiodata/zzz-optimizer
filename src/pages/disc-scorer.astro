---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const title = 'ZZZ Drive Disc Scorer – Roll Value & Crit Value';
const description =
  'Free Zenless Zone Zero disc scorer: enter your drive disc substats to get roll value %, crit value and a plain-language verdict. S/A/B rank grading, no sign-up.';

const faqs = [
  {
    q: 'What is a good roll value (RV) for a drive disc?',
    a: 'Community convention: 85%+ RV is a keeper you build the set around, 70–85% is a solid placeholder, 55–70% is fine until something better drops, and under 55% is fodder once you have alternatives. These bands are convention, not official — the RV math itself is exact.',
  },
  {
    q: 'What is crit value (CV)?',
    a: 'CV = 2 × Crit Rate% + Crit DMG%. Double-weighting crit rate reflects how much scarcer it is on discs. Crit-focused players often use CV alone; RV matters more for non-crit or anomaly builds.',
  },
  {
    q: 'Why does my disc show fewer than 4 substats?',
    a: 'Leave unused rows at "—". The scorer only counts filled rows and divides by 4 (the S-rank substat count), so a partially-leveled disc grades fairly against its final potential.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// S-rank max single-roll values, community-reported [VERIFY per patch]
const SUBSTATS: [string, number][] = [
  ['—', 0], ['ATK %', 3], ['Flat ATK', 19], ['HP %', 3], ['Flat HP', 112],
  ['DEF %', 4.8], ['Flat DEF', 15], ['Crit Rate', 2.4], ['Crit DMG', 4.8],
  ['PEN', 9], ['PEN Ratio %', 2.4], ['Anomaly Proficiency', 9],
];
---

<Base title={title} description={description} crumbs={[{ name: 'Tools', href: '/tools/' }, { name: 'Disc Scorer' }]} schema={[faqLd]}>
  <div class="page-head">
    <h1>Drive Disc Scorer</h1>
    <div class="h1-bar"></div>
    <p class="lede">
      Paste in what the disc rolled and get the two numbers that matter: roll value (% of perfect) and crit value.
      Graded in plain language before you waste tuner currency.
    </p>
    <div class="microline"><span>Free</span><span>No sign-up</span><span>Runs in your browser</span><span>Roll caps reviewed {SITE.lastVerified}</span></div>
  </div>

  <form class="tool panel accent" id="disc" autocomplete="off" onsubmit="return false">
    <div class="fields">
      {[0, 1, 2, 3].map((i) => (
        <label class="field">
          <span>{`Substat ${i + 1}`}</span>
          <select id={`sub${i}`}>
            {SUBSTATS.map(([label]) => <option value={label}>{label}</option>)}
          </select>
          <input id={`val${i}`} type="number" min="0" step="0.1" placeholder="rolled value" />
        </label>
      ))}
    </div>
    <button class="btn" type="button" onclick="scoreDisc()">Score disc</button>
    <button class="btn btn-ghost" type="button" onclick="loadDiscExample()">Load example</button>
  </form>

  <div class="result" id="result" aria-live="polite"></div>

  <section class="prose">
    <h2>How it works</h2>
    <p>Each substat is scored against its maximum single-roll value on an S-rank disc; the average of the four shares is your roll value. Crit value is the standard community convention.</p>
    <pre class="formula">RV% = 100 × Σ(valueᵢ ÷ maxRollᵢ) ÷ 4
CV  = 2 × Crit Rate% + Crit DMG%</pre>
    <p>Default roll caps: ATK% 3 · Flat ATK 19 · HP% 3 · Flat HP 112 · DEF% 4.8 · Flat DEF 15 · Crit Rate 2.4 · Crit DMG 4.8 · PEN 9 · PEN Ratio 2.4% · AP 9 — community-reported, [VERIFY] per patch on the <a href="/methodology/">methodology page</a>.</p>

    <h2>FAQ</h2>
    {faqs.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="prose">
    <h2>Related tools and guides</h2>
    <div class="cards">
      <a class="card" href="/crit-ratio/"><span class="ico">⚖️</span><h3>Crit Ratio Analyzer</h3><p>Now that you know the CV — is the ratio itself right?</p><span class="tag">Calculator</span></a>
      <a class="card" href="/damage-calculator/"><span class="ico">💥</span><h3>Damage Calculator</h3><p>Turn the scored disc into real hit numbers.</p><span class="tag">Calculator</span></a>
      <a class="card" href="/guides/how-disc-rolls-work/"><span class="ico">📘</span><h3>How disc rolls work</h3><p>Substat pools, roll counts, and the leveling system.</p><span class="tag">Guide</span></a>
    </div>
  </section>

  <div class="trust">
    <strong>Maintained by {SITE.brand}</strong> · Free, no-ads, no-account. Roll caps last reviewed <span class="mono">{SITE.lastVerified}</span> ·
    Formula and data policy: <a href="/methodology/">Methodology</a> · Found an error? <a href="/contact/">Report it</a>.
  </div>
</Base>

<script type="application/json" id="maxes" set:html={JSON.stringify(Object.fromEntries(SUBSTATS.slice(1)))} />
<script>
  const MAXES = JSON.parse(document.getElementById('maxes').textContent);
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  const numv = (id: string) => { const v = parseFloat($(id).value); return Number.isFinite(v) ? v : 0; };
  const fmt = (n: number, d = 1) => (Number.isFinite(n) ? new Intl.NumberFormat('en-US', { maximumFractionDigits: d }).format(n) : '—');

  function scoreDisc() {
    let sum = 0, used = 0;
    const crKey = 'Crit Rate', cdKey = 'Crit DMG';
    let cr = 0, cd = 0;
    const rows: string[] = [];
    for (let i = 0; i < 4; i++) {
      const key = ($('sub' + i) as HTMLSelectElement).value;
      const val = numv('val' + i);
      if (key === '—' || val <= 0) continue;
      const max = MAXES[key];
      if (!max) continue;
      const share = Math.min(val / max, 1.3);
      sum += share; used++;
      rows.push(`<div class="row"><span>${key}</span><b>${fmt(val, 1)} / ${max} → ${fmt(share * 100, 0)}%</b></div>`);
      if (key === crKey) cr = val;
      if (key === cdKey) cd = val;
    }
    if (used === 0) return;
    const rv = (sum / 4) * 100;
    const cv = 2 * cr + cd;
    const grade = rv >= 85 ? ['S — set-defining keeper', 'ok'] : rv >= 70 ? ['A — solid placeholder', 'ok'] : rv >= 55 ? ['B — usable, keep farming', 'warn'] : ['C — fodder when you have a spare', 'bad'];
    const el = document.getElementById('result')!;
    el.innerHTML = `
      <div class="stats">
        <div class="stat"><span class="k">Roll value</span><span class="v">${fmt(rv)}%</span></div>
        <div class="stat"><span class="k">Crit value</span><span class="v pink">${cv > 0 ? fmt(cv) : '—'}</span></div>
        <div class="stat"><span class="k">Substats counted</span><span class="v">${used}/4</span></div>
      </div>
      <div class="verdict ${grade[1]}">${rv >= 70 ? '✅' : rv >= 55 ? '⚠️' : '❌'} Grade ${grade[0]}</div>
      <div class="rows">${rows.join('')}</div>
      <p class="note">Grades follow community convention; the RV/CV math is exact. Roll caps are community estimates — <a href="/methodology/">methodology</a>.</p>`;
    (window as any).scoreDisc = scoreDisc;
  }

  function loadDiscExample() {
    const set = (id: string, v: string) => (($(id) as any).value = v);
    set('sub0', 'Crit Rate'); set('val0', '2.1');
    set('sub1', 'Crit DMG'); set('val1', '4.2');
    set('sub2', 'ATK %'); set('val2', '2.8');
    set('sub3', 'PEN'); set('val3', '6');
    scoreDisc();
  }

  (window as any).scoreDisc = scoreDisc;
  (window as any).loadDiscExample = loadDiscExample;
  document.getElementById('disc')?.addEventListener('input', scoreDisc);
</script>
